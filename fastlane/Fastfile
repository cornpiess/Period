require 'fileutils'
require 'base64'

default_platform(:ios)

platform :ios do
  lane :testflight do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    # xcodebuild -allowProvisioningUpdates 不会自动继承 fastlane 的 API key，
    # 云端签名必须显式传 -authenticationKey* 参数（归档和导出两个阶段都要）
    key_path = "/tmp/AuthKey_#{ENV['ASC_KEY_ID']}.p8"
    File.write(key_path, Base64.decode64(ENV["ASC_KEY_CONTENT"]))
    auth_args = "-allowProvisioningUpdates " \
                "-authenticationKeyPath #{key_path} " \
                "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
                "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    # 导出阶段 fastlane 会自动附加 API key 参数，手动再传会重复报错
    export_auth_args = "-allowProvisioningUpdates"

    build_app(
      project: "ios-lite/Period.xcodeproj",
      scheme: "Period",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "DEVELOPMENT_TEAM=#{ENV["TEAM_ID"]} CODE_SIGN_STYLE=Automatic #{auth_args}",
      export_xcargs: export_auth_args
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: false
    )
  end
end
